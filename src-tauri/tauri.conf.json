{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Convertisseur Local",
  "version": "0.2.0",
  "identifier": "fr.local.convertisseur",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Convertisseur Local",
        "width": 1120,
        "height": 840,
        "minWidth": 760,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/pandoc",
      "binaries/typst"
    ],
    "resources": [
      "third-party/FFmpeg-GPLv3.txt",
      "third-party/FFmpeg-SOURCE.txt",
      "third-party/Pandoc-GPLv2.txt",
      "third-party/Pandoc-SOURCE.txt",
      "third-party/Typst-Apache-2.0.txt",
      "third-party/Typst-SOURCE.txt"
    ],
    "windows": {
      "wix": {
        "language": "fr-FR"
      },
      "nsis": {
        "languages": ["French"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
